# Copy to .env in the repo root for local development.
# Keep real credentials in your local environment or a deployment secret manager.

# Primary free vision provider (Google AI Studio)
GEMINI_API_KEY=

# Optional paid/alternate vision provider
ANTHROPIC_API_KEY=

# Optional caption-only fallback
HF_TOKEN=

# Optional absolute API URL for hosting the frontend separately from the API.
# Leave empty for Vercel or Render same-origin deployments.
VITE_API_BASE_URL=
